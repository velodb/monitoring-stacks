{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Cluster-dimension monitoring dashboard. PromQL extracted from nexus/monitor/expression.go. Covers BE node, query, cache, remote S3, load and tablet metrics. Set $wid (warehouse) and $cid (compute cluster) before use.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "panels": [],
      "title": "Cluster Health",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 1},
      "id": 1,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "sum(1 - up{wid=\"$wid\", cid=\"$cid\"}) by (wid, cid)",
        "legendFormat": "Dead Nodes",
        "refId": "A"
      }],
      "title": "BE Dead Node Count",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 7},
      "id": 101,
      "panels": [],
      "title": "Node Resources (BE)",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 2,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "100 - (sum(rate(node_cpu_seconds_total{mode=\"idle\", wid=\"$wid\", cid=\"$cid\"}[$interval])) by (wid, cid, instance)) / (sum(rate(node_cpu_seconds_total{wid=\"$wid\", cid=\"$cid\"}[$interval])) by (wid, cid, instance)) * 100",
        "legendFormat": "{{instance}}",
        "refId": "A"
      }],
      "title": "BE CPU Utilization",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 3,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "sum(node_memory_MemTotal_bytes{wid=\"$wid\", cid=\"$cid\"} - node_memory_MemFree_bytes{wid=\"$wid\", cid=\"$cid\"} - node_memory_Cached_bytes{wid=\"$wid\", cid=\"$cid\"} - node_memory_Buffers_bytes{wid=\"$wid\", cid=\"$cid\"} - node_memory_SReclaimable_bytes{wid=\"$wid\", cid=\"$cid\"}) by (wid, cid, instance) / sum(node_memory_MemTotal_bytes{wid=\"$wid\", cid=\"$cid\"}) by (wid, cid, instance) * 100",
        "legendFormat": "{{instance}}",
        "refId": "A"
      }],
      "title": "BE Memory Utilization",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "id": 4,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "sum(rate(node_disk_io_time_seconds_total{wid=\"$wid\", cid=\"$cid\"}[$interval])) by (wid, cid, instance)",
        "legendFormat": "{{instance}}",
        "refId": "A"
      }],
      "title": "BE IO Utilization",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 24},
      "id": 102,
      "panels": [],
      "title": "Query Performance",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 25},
      "id": 5,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "sum(rate(doris_fe_query_total{wid=\"$wid\", cluster_id=\"$cid\"}[$interval])) by (wid)",
        "legendFormat": "QPS",
        "refId": "A"
      }],
      "title": "QPS",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 25},
      "id": 6,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "(1 - sum(rate(doris_fe_query_err{wid=\"$wid\", cluster_id=\"$cid\"}[$interval])) / clamp_min(sum(rate(doris_fe_query_total{wid=\"$wid\", cluster_id=\"$cid\"}[$interval])), 1)) * 100",
        "legendFormat": "Success Rate",
        "refId": "A"
      }],
      "title": "Query Success Rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ms", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 33},
      "id": 7,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "sum(doris_fe_query_latency_ms_sum{wid=\"$wid\", cluster_id=\"$cid\"}) by (wid) / clamp_min(sum(doris_fe_query_latency_ms_count{wid=\"$wid\", cluster_id=\"$cid\"}) by (wid), 1)",
        "legendFormat": "Avg Latency",
        "refId": "A"
      }],
      "title": "Query Average Latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ms", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 33},
      "id": 8,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "(avg(doris_fe_query_latency_ms{wid=\"$wid\", cluster_id=\"$cid\", quantile=\"0.99\"} > 0) by (wid) or label_replace(vector(0), \"wid\", \"$wid\", \"\", \"\"))",
        "legendFormat": "P99 Latency",
        "refId": "A"
      }],
      "title": "Query P99 Latency",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 41},
      "id": 103,
      "panels": [],
      "title": "Cache",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 42},
      "id": 9,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "clamp_min(sum(increase(doris_be_num_io_bytes_read_from_cache{wid=\"$wid\", cid=\"$cid\"}[$interval])) by (wid, cid), 1) / clamp_min(sum(increase(doris_be_num_io_bytes_read_total{wid=\"$wid\", cid=\"$cid\"}[$interval])) by (wid, cid), 1) * 100",
        "legendFormat": "Cache Hit Rate",
        "refId": "A"
      }],
      "title": "Cache Hit Rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 42},
      "id": 10,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "sum({__name__=~'^(_mnt|_data[0-9]+)_storage_file_cache_file_cache_cache_size', wid=\"$wid\", cid=\"$cid\"}) by (wid, cid) / sum({__name__=~'^(_mnt|_data[0-9]+)_storage_file_cache_file_cache_capacity', wid=\"$wid\", cid=\"$cid\"}) by (wid, cid) * 100",
        "legendFormat": "Cache Utilization",
        "refId": "A"
      }],
      "title": "Cache Utilization",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 50},
      "id": 104,
      "panels": [],
      "title": "Remote S3",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 51},
      "id": 11,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "label_replace(sum(s3_put_qps{wid=\"$wid\", cid=\"$cid\"}) by (wid, cid), \"operation\", \"Write\", \"\", \"\") or label_replace(sum(s3_get_qps{wid=\"$wid\", cid=\"$cid\"}) by (wid, cid), \"operation\", \"Read\", \"\", \"\")",
        "legendFormat": "{{operation}}",
        "refId": "A"
      }],
      "title": "Remote S3 Read/Write QPS",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "Bps", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 51},
      "id": 12,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "label_replace(sum(rate(s3_file_reader_bytes_read{wid=\"$wid\", cid=\"$cid\"}[$interval])) by (wid, cid), \"operation\", \"Read\", \"\", \"\") or label_replace(sum(rate(s3_file_writer_bytes_written{wid=\"$wid\", cid=\"$cid\"}[$interval])) by (wid, cid), \"operation\", \"Write\", \"\", \"\")",
        "legendFormat": "{{operation}}",
        "refId": "A"
      }],
      "title": "Remote S3 Throughput",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 59},
      "id": 105,
      "panels": [],
      "title": "Load",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "MBs", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 60},
      "id": 13,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "sum(rate(doris_be_load_bytes{wid=\"$wid\", cid=\"$cid\"}[$interval])) by (wid) / 1048576",
        "legendFormat": "Load Speed",
        "refId": "A"
      }],
      "title": "Load Bytes Speed",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 60},
      "id": 14,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "sum(rate(doris_be_streaming_load_requests_total{wid=\"$wid\", cid=\"$cid\"}[$interval])) by (wid, cid)",
        "legendFormat": "Stream Load",
        "refId": "A"
      }],
      "title": "Stream Load Job Frequency",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 68},
      "id": 106,
      "panels": [],
      "title": "Tablet",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 69},
      "id": 15,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "label_replace(max(doris_be_tablet_cumulative_max_compaction_score{wid=\"$wid\", cid=\"$cid\"}) by (wid, cid), \"operation\", \"Cumulative\", \"\", \"\") or label_replace(max(doris_be_tablet_base_max_compaction_score{wid=\"$wid\", cid=\"$cid\"}) by (wid, cid), \"operation\", \"Base\", \"\", \"\")",
        "legendFormat": "{{operation}}",
        "refId": "A"
      }],
      "title": "Tablet Compaction Score",
      "type": "timeseries"
    }
  ],
