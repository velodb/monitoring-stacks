  "description": "Warehouse-dimension monitoring dashboard. PromQL extracted from nexus/monitor/expression.go. Covers FE node, query, connection/storage, load jobs, routine load and workload group. Set $wid to the target warehouse ID before use.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "panels": [],
      "title": "Node Resources (FE)",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 1},
      "id": 1,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "100 - (sum(rate(node_cpu_seconds_total{mode=\"idle\", job=\"$wid\"}[$interval])) by (job, instance)) / (sum(rate(node_cpu_seconds_total{job=\"$wid\"}[$interval])) by (job, instance)) * 100",
        "legendFormat": "{{instance}}",
        "refId": "A"
      }],
      "title": "FE CPU Utilization",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 1},
      "id": 2,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "sum(node_memory_MemTotal_bytes{job=\"$wid\"} - node_memory_MemFree_bytes{job=\"$wid\"} - node_memory_Cached_bytes{job=\"$wid\"} - node_memory_Buffers_bytes{job=\"$wid\"} - node_memory_SReclaimable_bytes{job=\"$wid\"}) by (job, instance) / sum(node_memory_MemTotal_bytes{job=\"$wid\"}) by (job, instance) * 100",
        "legendFormat": "{{instance}}",
        "refId": "A"
      }],
      "title": "FE Memory Utilization",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 9},
      "id": 3,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "sum(rate(node_disk_io_time_seconds_total{job=\"$wid\"}[$interval])) by (job, instance)",
        "legendFormat": "{{instance}}",
        "refId": "A"
      }],
      "title": "FE IO Utilization",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 9},
      "id": 4,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "sum(jvm_heap_size_bytes{wid=\"$wid\", type=\"used\"}) by (instance) / sum(jvm_heap_size_bytes{wid=\"$wid\", type=\"max\"}) by (instance) * 100",
        "legendFormat": "{{instance}}",
        "refId": "A"
      }],
      "title": "FE JVM Heap Usage",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 17},
      "id": 101,
      "panels": [],
      "title": "Query Performance",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 18},
      "id": 5,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "sum(rate(doris_fe_query_total{wid=\"$wid\"}[$interval])) by (wid)",
        "legendFormat": "QPS",
        "refId": "A"
      }],
      "title": "QPS",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 18},
      "id": 6,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "(1 - sum(rate(doris_fe_query_err{wid=\"$wid\"}[$interval])) / clamp_min(sum(rate(doris_fe_query_total{wid=\"$wid\"}[$interval])), 1)) * 100",
        "legendFormat": "Success Rate",
        "refId": "A"
      }],
      "title": "Query Success Rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ms", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 26},
      "id": 7,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "sum(doris_fe_query_latency_ms_sum{wid=\"$wid\"}) by (wid) / clamp_min(sum(doris_fe_query_latency_ms_count{wid=\"$wid\"}) by (wid), 1)",
        "legendFormat": "Avg Latency",
        "refId": "A"
      }],
      "title": "Query Average Latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ms", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 26},
      "id": 8,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "(avg(doris_fe_query_latency_ms{wid=\"$wid\", quantile=\"0.99\"} > 0) by (wid) or on() vector(0))",
        "legendFormat": "P99 Latency",
        "refId": "A"
      }],
      "title": "Query P99 Latency",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 34},
      "id": 102,
      "panels": [],
      "title": "Connections & Storage",
