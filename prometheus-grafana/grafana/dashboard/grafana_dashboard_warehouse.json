      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "sum(doris_fe_job{wid=\"$wid\", exported_job=\"load\", type=\"ROUTINE_LOAD\", state=\"ABNORMAL_PAUSED\"}) by (wid)",
        "legendFormat": "Abnormal Paused",
        "refId": "A"
      }],
      "title": "Routine Load Job Abnormal Paused",
