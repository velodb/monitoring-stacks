      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "sum(rate(doris_fe_job{wid=\"$wid\", exported_job=\"load\", type=\"BROKER\", state=\"FINISHED\"}[$interval])) by (wid)",
        "legendFormat": "Broker Load",
        "refId": "A"
      }],
      "title": "Broker Load Job Frequency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 52},
      "id": 14,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "sum(rate(doris_fe_job{wid=\"$wid\", exported_job=\"load\", type=\"INSERT\", state=\"FINISHED\"}[$interval])) by (wid)",
        "legendFormat": "Insert Into",
